# Extra asterctl options for aoostar-panels.service.
# Apply changes with: systemctl restart aoostar-panels
#
# Burn-in protection:
#   --pixel-shift N         move the whole panel by one pixel every N minutes
#   --pixel-shift-max PX    maximum offset in each direction (default 2)
#   --wipe-interval N       show the inverted panel every N minutes
#   --wipe-duration S       ... for S seconds (default 3)
#   --off-hours HH:MM-HH:MM switch the display off during this daily window
#
# Other:
#   --stale-after S         show `--` for values not refreshed for S seconds (default 30)
ASTERCTL_OPTS=--pixel-shift 5 --wipe-interval 60 --off-hours 23:00-07:00
